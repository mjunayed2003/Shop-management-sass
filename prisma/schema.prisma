  sales_return  SalesReturn    @relation("ReturnExchange", fields: [sales_return_id], references: [id], onDelete: Restrict)
  new_sale      Sale           @relation("NewSaleExchange", fields: [new_sale_id], references: [id], onDelete: Restrict)
  items         ExchangeItem[]

  @@unique([business_id, branch_id, exchange_no])
  @@unique([business_id, idempotency_key])
  @@index([business_id, branch_id])
  @@map("exchanges")
}

