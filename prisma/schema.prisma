// ============================================================================
// GROUP 6: SALES MODELS
// ============================================================================

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  business_id    String    @db.Uuid
  name           String
  phone          String
  email          String?
  address        String?
  opening_due    Decimal   @default(0) @db.Decimal(18, 2)
  current_due    Decimal   @default(0) @db.Decimal(18, 2)
  credit_limit   Decimal   @default(0) @db.Decimal(18, 2)
  loyalty_points Int       @default(0)
  is_active      Boolean   @default(true)
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  business        Business        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  sales           Sale[]
  held_sales      HeldSale[]
  sales_returns   SalesReturn[]
  due_collections DueCollection[]

  @@unique([business_id, phone])
  @@index([business_id, name])
  @@index([business_id, phone])
  @@map("customers")
}

model Sale {
  id                  String     @id @default(uuid()) @db.Uuid
  business_id         String     @db.Uuid
  branch_id           String     @db.Uuid
  customer_id         String?    @db.Uuid
  cash_register_id    String?    @db.Uuid
  register_session_id String?    @db.Uuid
  invoice_no          String
  idempotency_key     String
  sale_type           SaleType   @default(RETAIL)
  status              SaleStatus @default(COMPLETED)
  sale_date           DateTime   @default(now())
  subtotal            Decimal    @db.Decimal(18, 2)
  discount_amount     Decimal    @default(0) @db.Decimal(18, 2)
  coupon_id           String?    @db.Uuid
  tax_amount          Decimal    @default(0) @db.Decimal(18, 2)
  round_off           Decimal    @default(0) @db.Decimal(18, 2)
  total_amount        Decimal    @db.Decimal(18, 2)
  paid_amount         Decimal    @default(0) @db.Decimal(18, 2)
  due_amount          Decimal    @default(0) @db.Decimal(18, 2)
  change_amount       Decimal    @default(0) @db.Decimal(18, 2)
  total_cost          Decimal    @default(0) @db.Decimal(18, 2)
  is_offline          Boolean    @default(false)
  synced_at           DateTime?
  voided_at           DateTime?
  void_reason         String?
  created_by          String     @db.Uuid
  updated_by          String?    @db.Uuid
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  business          Business         @relation(fields: [business_id], references: [id], onDelete: Cascade)
  branch            Branch           @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  customer          Customer?        @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  cash_register     CashRegister?    @relation(fields: [cash_register_id], references: [id], onDelete: SetNull)
  register_session  RegisterSession? @relation(fields: [register_session_id], references: [id], onDelete: SetNull)
  coupon            Coupon?          @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items             SaleItem[]
  payments          SalePayment[]
  returns           SalesReturn[]
  original_exchange Exchange[]       @relation("OriginalSaleExchanges")
  new_exchange      Exchange?        @relation("NewSaleExchange")
