// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum SuperAdminRole {
  SUPER_ADMIN
  PLATFORM_SUPPORT
  BILLING_ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAYMENT_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlatformInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum PlatformPaymentMethod {
  BKASH
  NAGAD
  BANK_TRANSFER
  CARDS
  CASH
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum Gender {
  MEN
  WOMEN
  BOYS
  GIRLS
  UNISEX
  KIDS
}

enum PriceListType {
  RETAIL
  WHOLESALE
  FESTIVE_OFFER
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  EXCHANGE_IN
  EXCHANGE_OUT
  DAMAGE
  ADJUSTMENT_POSITIVE
  ADJUSTMENT_NEGATIVE
  TRANSFER_OUT
  TRANSFER_IN
}

enum StockReferenceType {
  PURCHASE
  SALE
  RETURN
  EXCHANGE
  ADJUSTMENT
  TRANSFER
  STOCKTAKE
  OPENING_BALANCE
}

enum AdjustmentReason {
  PHYSICAL_COUNT_DISCREPANCY
  FOUND_STOCK
  EXPIRED
  INTERNAL_USE
  OTHER
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  RECEIVED
  REJECTED
  CANCELLED
}

enum StocktakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DamageStatus {
  PENDING
  APPROVED
  WRITTEN_OFF
}

enum POStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  CARDS
  CHEQUE
}

enum SaleType {
  RETAIL
  WHOLESALE
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_PAID
  DUE
  VOIDED
  RETURNED
  EXCHANGED
}

enum RefundMethod {
  CASH
  BKASH
  NAGAD
  STORE_CREDIT
  ADJUSTED_IN_EXCHANGE
}

enum ItemCondition {
  RESELLABLE
  DAMAGED
}

enum ExchangeDiffStatus {
  CUSTOMER_PAID
  SHOP_REFUNDED
  EVEN
}

enum ExchangeItemType {
  RETURNED
  TAKEN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalRefType {
  SALE
  SALE_RETURN
  PURCHASE
  PURCHASE_RETURN
  DUE_COLLECTION
  SUPPLIER_PAYMENT
  EXPENSE
  STOCK_ADJUSTMENT
  CASH_MOVEMENT
  MANUAL
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PaymentAccountType {
  CASH
  BANK
  BKASH
  NAGAD
  UPAY
  ROCKET
}

enum SequenceType {
  SALE_INVOICE
  PURCHASE_INVOICE
  RETURN_INVOICE
  TRANSFER_INVOICE
  JOURNAL_ENTRY
  EXPENSE_VOUCHER
}

enum NotificationType {
  LOW_STOCK
  SUBSCRIPTION_DUE
  SYSTEM_ALERT
  TRANSFER_REQUEST
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

enum SmsPurpose {
  SALE_INVOICE
  DUE_REMINDER
  OTP
  PROMOTIONAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VOID
  LOGIN
  LOGOUT
  SYNC
  APPROVE
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SyncStatus {
  PENDING
  PROCESSED
  CONFLICT
  FAILED
}

enum UnitStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
  LOST
  IN_TRANSIT
}

enum BarcodePrintType {
  INITIAL_PRINT
  REPRINT
}

// ============================================================================
// GROUP 1: PLATFORM MODELS
// ============================================================================

model SuperAdmin {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  password_hash String
  first_name    String
  last_name     String
  phone         String?
  role          SuperAdminRole @default(PLATFORM_SUPPORT)
  is_active     Boolean        @default(true)
  last_login_at DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  subscription_overrides SubscriptionOverride[]
  support_tickets        SupportTicket[]

  @@map("super_admins")
}

model Plan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  code          String   @unique
  description   String?
  monthly_price Decimal  @db.Decimal(18, 2)
  yearly_price  Decimal  @db.Decimal(18, 2)
  trial_days    Int      @default(30)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  limits                PlanLimit?
  subscriptions         Subscription[]
  subscription_invoices SubscriptionInvoice[]

  @@map("plans")
}

model PlanLimit {
  id                   String   @id @default(uuid()) @db.Uuid
  plan_id              String   @unique @db.Uuid
  max_branches         Int      @default(1)
  max_users            Int      @default(3)
  max_products         Int      @default(500)
  max_variants         Int      @default(1500)
  max_monthly_invoices Int      @default(1000)
  has_api_access       Boolean  @default(false)
  has_custom_reports   Boolean  @default(false)
  has_offline_sync     Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  plan Plan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@map("plan_limits")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  business_id          String             @unique @db.Uuid
  plan_id              String             @db.Uuid
  status               SubscriptionStatus @default(TRIAL)
  billing_cycle        BillingCycle       @default(MONTHLY)
  current_period_start DateTime           @default(now())
  current_period_end   DateTime
  trial_starts_at      DateTime           @default(now())
  trial_ends_at        DateTime
  grace_ends_at        DateTime?
  cancelled_at         DateTime?
  is_free_access       Boolean            @default(false)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  business Business              @relation(fields: [business_id], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  invoices SubscriptionInvoice[]

  @@map("subscriptions")
}

model SubscriptionOverride {
  id                    String    @id @default(uuid()) @db.Uuid
  business_id           String    @db.Uuid
  super_admin_id        String    @db.Uuid
  custom_monthly_price  Decimal?  @db.Decimal(18, 2)
  custom_yearly_price   Decimal?  @db.Decimal(18, 2)
  discount_percentage   Decimal?  @db.Decimal(5, 2)
  is_free_access        Boolean   @default(false)
  override_max_branches Int?
  override_max_users    Int?
  override_max_products Int?
  override_max_variants Int?
  trial_extended_days   Int?
  reason                String
  valid_until           DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  business    Business   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  super_admin SuperAdmin @relation(fields: [super_admin_id], references: [id], onDelete: Restrict)

  @@index([business_id])
  @@map("subscription_overrides")
}

model SubscriptionInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  invoice_no      String                @unique
  business_id     String                @db.Uuid
  subscription_id String                @db.Uuid
  plan_id         String                @db.Uuid
  amount          Decimal               @db.Decimal(18, 2)
  discount_amount Decimal               @default(0) @db.Decimal(18, 2)
  net_amount      Decimal               @db.Decimal(18, 2)
  status          PlatformInvoiceStatus @default(ISSUED)
  billing_start   DateTime
  billing_end     DateTime
  due_date        DateTime
  paid_at         DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  business     Business          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  plan         Plan              @relation(fields: [plan_id], references: [id], onDelete: Restrict)
  payments     PlatformPayment[]

  @@index([business_id, status])
  @@map("subscription_invoices")
}

model PlatformPayment {
  id             String                @id @default(uuid()) @db.Uuid
  invoice_id     String                @db.Uuid
  business_id    String                @db.Uuid
  amount         Decimal               @db.Decimal(18, 2)
  payment_method PlatformPaymentMethod
  transaction_id String?
  provider_ref   String?
  status         PlatformInvoiceStatus @default(PAID)
  paid_at        DateTime?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  invoice  SubscriptionInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  business Business            @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id])
  @@map("platform_payments")
}

model SupportTicket {
  id                String         @id @default(uuid()) @db.Uuid
  ticket_no         String         @unique
  business_id       String         @db.Uuid
  user_id           String?        @db.Uuid
  assigned_admin_id String?        @db.Uuid
  subject           String
  description       String
  priority          TicketPriority @default(MEDIUM)
  status            TicketStatus   @default(OPEN)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  business       Business    @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user           User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  assigned_admin SuperAdmin? @relation(fields: [assigned_admin_id], references: [id], onDelete: SetNull)

  @@index([business_id, status])
  @@map("support_tickets")
}

model SystemSetting {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  value        String
  description  String?
  is_encrypted Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================================
// GROUP 2: TENANT MODELS
// ============================================================================

model Business {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  slug             String         @unique
  legal_name       String?
  trade_license_no String?
  tin_no           String?
  bin_no           String?
  phone            String
  email            String
  currency         String         @default("BDT")
  timezone         String         @default("Asia/Dhaka")
  status           BusinessStatus @default(ACTIVE)
  is_active        Boolean        @default(true)
  deleted_at       DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  branches               Branch[]
  users                  User[]
  roles                  Role[]
  categories             Category[]
  brands                 Brand[]
  seasons                Season[]
  sizes                  Size[]
  colors                 Color[]
  units                  Unit[]
  products               Product[]
  product_variants       ProductVariant[]
  price_lists            PriceList[]
  stock_movements        StockMovement[]
  stock_balances         StockBalance[]
  stock_adjustments      StockAdjustment[]
  stock_transfers        StockTransfer[]
  stocktakes             Stocktake[]
  damaged_stocks         DamagedStock[]
  suppliers              Supplier[]
  purchase_orders        PurchaseOrder[]
  purchases              Purchase[]
  purchase_returns       PurchaseReturn[]
  supplier_payments      SupplierPayment[]
  customers              Customer[]
  sales                  Sale[]
  sale_payments          SalePayment[]
  held_sales             HeldSale[]
  sales_returns          SalesReturn[]
  exchanges              Exchange[]
  due_collections        DueCollection[]
  discounts              Discount[]
  coupons                Coupon[]
  cash_registers         CashRegister[]
  register_sessions      RegisterSession[]
  cash_movements         CashMovement[]
  chart_of_accounts      ChartOfAccount[]
  journal_entries        JournalEntry[]
  fiscal_periods         FiscalPeriod[]
  payment_accounts       PaymentAccount[]
  expense_categories     ExpenseCategory[]
  expenses               Expense[]
  invoice_sequences      InvoiceSequence[]
  notifications          Notification[]
  sms_logs               SmsLog[]
  audit_logs             AuditLog[]
  idempotency_keys       IdempotencyKey[]
  attachments            Attachment[]
  sync_queues            SyncQueue[]
  subscription           Subscription?
  subscription_overrides SubscriptionOverride[]
  subscription_invoices  SubscriptionInvoice[]
  platform_payments      PlatformPayment[]
  support_tickets        SupportTicket[]
  user_sessions          UserSession[]
  user_branch_access     UserBranchAccess[]
  product_units          ProductUnit[]
  barcode_print_logs     BarcodePrintLog[]
  product_branches       ProductBranch[]

  @@map("businesses")
}

model Branch {
  id          String    @id @default(uuid()) @db.Uuid
  business_id String    @db.Uuid
  name        String
  code        String
  address     String
  city        String    @default("Dhaka")
  state       String?
  postal_code String?
  phone       String
  email       String?
  is_main     Boolean   @default(false)
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  business           Business           @relation(fields: [business_id], references: [id], onDelete: Cascade)
  user_branch_access UserBranchAccess[]
  stock_movements    StockMovement[]
  stock_balances     StockBalance[]
  stock_adjustments  StockAdjustment[]
  stocktakes         Stocktake[]
  damaged_stocks     DamagedStock[]
  transfers_sent     StockTransfer[]    @relation("TransfersSent")
  transfers_received StockTransfer[]    @relation("TransfersReceived")
  purchase_orders    PurchaseOrder[]
  purchases          Purchase[]
  purchase_returns   PurchaseReturn[]
  supplier_payments  SupplierPayment[]
  sales              Sale[]
  sale_payments      SalePayment[]
  held_sales         HeldSale[]
  sales_returns      SalesReturn[]
  exchanges          Exchange[]
  due_collections    DueCollection[]
  cash_registers     CashRegister[]
  register_sessions  RegisterSession[]
  cash_movements     CashMovement[]
  journal_entries    JournalEntry[]
  payment_accounts   PaymentAccount[]
  expenses           Expense[]
  invoice_sequences  InvoiceSequence[]
  notifications      Notification[]
  sms_logs           SmsLog[]
  audit_logs         AuditLog[]
  sync_queues        SyncQueue[]
  product_units      ProductUnit[]
  barcode_print_logs BarcodePrintLog[]
  product_branches   ProductBranch[]

  @@unique([business_id, code])
  @@index([business_id, is_active])
  @@map("branches")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  business_id   String    @db.Uuid
  first_name    String
  last_name     String
  email         String
  phone         String
  password_hash String
  role_id       String    @db.Uuid
  is_owner      Boolean   @default(false)
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  business           Business           @relation(fields: [business_id], references: [id], onDelete: Cascade)
  role               Role               @relation(fields: [role_id], references: [id], onDelete: Restrict)
  user_branch_access UserBranchAccess[]
  sessions           UserSession[]
  support_tickets    SupportTicket[]
  register_sessions  RegisterSession[]
  notifications      Notification[]
  audit_logs         AuditLog[]
  barcode_print_logs BarcodePrintLog[]

  @@unique([business_id, email])
  @@unique([business_id, phone])
  @@index([business_id, role_id])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String?  @db.Uuid
  name        String
  code        String
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business         Business?        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  users            User[]
  role_permissions RolePermission[]

  @@unique([business_id, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  module      String
  description String?
  created_at  DateTime @default(now())

  role_permissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.Uuid
  role_id       String   @db.Uuid
  permission_id String   @db.Uuid
  created_at    DateTime @default(now())

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserBranchAccess {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  branch_id   String   @db.Uuid
  business_id String   @db.Uuid
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([user_id, branch_id])
  @@index([business_id])
  @@map("user_branch_access")
}

model UserSession {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  business_id String   @db.Uuid
  token_hash  String   @unique
  ip_address  String?
  user_agent  String?
  expires_at  DateTime
  is_revoked  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, user_id])
  @@map("user_sessions")
}

// ============================================================================
// GROUP 3: CATALOG MODELS
// ============================================================================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  business_id String    @db.Uuid
  parent_id   String?   @db.Uuid
  name        String
  code        String
  description String?
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  business Business   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([business_id, code])
  @@index([business_id, is_active])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  business_id String    @db.Uuid
  name        String
  code        String
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  business Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([business_id, code])
  @@index([business_id])
  @@map("brands")
}

model Season {
  id          String    @id @default(uuid()) @db.Uuid
  business_id String    @db.Uuid
  name        String
  code        String
  start_date  DateTime?
  end_date    DateTime?
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  business Business  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([business_id, code])
  @@index([business_id])
  @@map("seasons")
}

model Size {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String?  @db.Uuid
  name        String
  code        String
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business Business?        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([business_id, code])
  @@map("sizes")
}

model Color {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String?  @db.Uuid
  name        String
  code        String
  hex_code    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business Business?        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([business_id, code])
  @@map("colors")
}

model Unit {
  id            String   @id @default(uuid()) @db.Uuid
  business_id   String?  @db.Uuid
  name          String
  code          String
  allow_decimal Boolean  @default(false)
  created_at    DateTime @default(now())

  business Business? @relation(fields: [business_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([business_id, code])
  @@map("units")
}

model Product {
  id                 String    @id @default(uuid()) @db.Uuid
  business_id        String    @db.Uuid
  category_id        String    @db.Uuid
  brand_id           String?   @db.Uuid
  season_id          String?   @db.Uuid
  unit_id            String    @db.Uuid
  name               String
  code               String
  gender             Gender    @default(UNISEX)
  fabric             String?
  description        String?
  has_variants       Boolean   @default(true)
  track_individually Boolean   @default(false)
  is_active          Boolean   @default(true)
  deleted_at         DateTime?
  created_by         String?   @db.Uuid
  updated_by         String?   @db.Uuid
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  business Business         @relation(fields: [business_id], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [category_id], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  season   Season?          @relation(fields: [season_id], references: [id], onDelete: SetNull)
  unit     Unit             @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  branches ProductBranch[]

  @@unique([business_id, code])
  @@index([business_id, name])
  @@index([business_id, category_id])
  @@index([business_id, is_active])
  @@map("products")
}

model ProductBranch {
  id          String   @id @default(uuid()) @db.Uuid
  business_id String   @db.Uuid
  product_id  String   @db.Uuid
  branch_id   String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([product_id, branch_id])
  @@index([business_id, branch_id, is_active])
  @@map("product_branches")
}

model ProductVariant {
  id              String    @id @default(uuid()) @db.Uuid
  business_id     String    @db.Uuid
  product_id      String    @db.Uuid
  size_id         String?   @db.Uuid
  color_id        String?   @db.Uuid
  sku             String
  barcode         String
  retail_price    Decimal   @db.Decimal(18, 2)
  wholesale_price Decimal   @db.Decimal(18, 2)
  cost_price      Decimal   @db.Decimal(18, 2)
  reorder_level   Int       @default(5)
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  business               Business              @relation(fields: [business_id], references: [id], onDelete: Cascade)
  product                Product               @relation(fields: [product_id], references: [id], onDelete: Cascade)
  size                   Size?                 @relation(fields: [size_id], references: [id], onDelete: SetNull)
  color                  Color?                @relation(fields: [color_id], references: [id], onDelete: SetNull)
  price_list_items       PriceListItem[]
  stock_movements        StockMovement[]
  stock_balances         StockBalance[]
  stock_adjustment_items StockAdjustmentItem[]
  stock_transfer_items   StockTransferItem[]
  stocktake_items        StocktakeItem[]
  damaged_stocks         DamagedStock[]
  purchase_order_items   PurchaseOrderItem[]
  purchase_items         PurchaseItem[]
  purchase_return_items  PurchaseReturnItem[]
  sale_items             SaleItem[]
  held_sale_items        HeldSaleItem[]
  sales_return_items     SalesReturnItem[]
  exchange_items         ExchangeItem[]
  product_units          ProductUnit[]
  barcode_print_logs     BarcodePrintLog[]

  @@unique([business_id, sku])
  @@unique([business_id, barcode])
  @@index([business_id, barcode])
  @@index([business_id, sku])
  @@index([product_id])
  @@map("product_variants")
}

model ProductUnit {
  id                 String     @id @default(uuid()) @db.Uuid
  business_id        String     @db.Uuid
  branch_id          String     @db.Uuid
  product_variant_id String     @db.Uuid
  barcode_value      String
  status             UnitStatus @default(IN_STOCK)
  purchase_id        String?    @db.Uuid
  sold_sale_id       String?    @db.Uuid
  sold_at            DateTime?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  business   Business          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  branch     Branch            @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  variant    ProductVariant    @relation(fields: [product_variant_id], references: [id], onDelete: Restrict)
  purchase   Purchase?         @relation(fields: [purchase_id], references: [id], onDelete: SetNull)
  sold_sale  Sale?             @relation("SoldUnits", fields: [sold_sale_id], references: [id], onDelete: SetNull)
  sale_items SaleItem[]
  print_logs BarcodePrintLog[]

  @@unique([business_id, barcode_value])
  @@index([business_id, branch_id, status])
  @@index([product_variant_id, status])
  @@index([sold_sale_id])
  @@map("product_units")
}

model BarcodePrintLog {
  id                 String           @id @default(uuid()) @db.Uuid
  business_id        String           @db.Uuid
  branch_id          String           @db.Uuid
  product_unit_id    String?          @db.Uuid
  product_variant_id String?          @db.Uuid
  barcode_value      String
  print_type         BarcodePrintType @default(INITIAL_PRINT)
  reason             String?
  printed_by         String           @db.Uuid
  printed_at         DateTime         @default(now())
  label_format       String           @default("CODE_128")
  quantity_printed   Int              @default(1)

  business        Business        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product_unit    ProductUnit?    @relation(fields: [product_unit_id], references: [id], onDelete: SetNull)
  product_variant ProductVariant? @relation(fields: [product_variant_id], references: [id], onDelete: SetNull)
  user            User            @relation(fields: [printed_by], references: [id], onDelete: Restrict)

  @@index([business_id, branch_id, printed_at])
  @@index([business_id, barcode_value])
  @@map("barcode_print_logs")
}

model PriceList {
  id          String        @id @default(uuid()) @db.Uuid
